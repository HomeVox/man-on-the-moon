# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.4 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_CACHE_DEF_SIZE=1048576
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=2
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=65
CONFIG_LV_FS_STDIO_CACHE_SIZE=1048576
CONFIG_LV_USE_LODEPNG=y
# CONFIG_LV_USE_TJPGD is not set (botst met esp_jpeg)
CONFIG_LV_USE_DEMO_BENCHMARK=y
CONFIG_LV_USE_DEMO_STRESS=y
CONFIG_LV_USE_DEMO_SMARTWATCH=y
# --- Kantoor ---
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=256
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_JD_USE_ROM=n
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
# TLS-geheugen (verbinding met de Frame) uit PSRAM, intern RAM is krap
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Crashdump bewaren op flash, uit te lezen met idf.py coredump-info
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# Wifi- en netwerkbuffers in PSRAM: intern RAM is krap
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Middelgrote aanvragen (vanaf 4 KB) ook naar PSRAM: intern RAM is krap
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Intern RAM vrijmaken (was de oorzaak van haperen):
# - geen aparte teken-threads (2x 8 KB stack, gaf nauwelijks winst)
# - minder wifi-ontvangstbuffers (16 -> 8)
# - wifi-code niet in IRAM: op de S3 deelt IRAM het RAM met data
CONFIG_LV_OS_NONE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Sockets: webserver (OTA/stats), HA http + websocket, WiiM https, mDNS
CONFIG_LWIP_MAX_SOCKETS=16

# Jarvis: snellere JPEG-decoder (tabel voor Huffman) voor de voorgerenderde lussen
CONFIG_JD_FASTDECODE_TABLE=y

# Jarvis: -O2 in plaats van -Og (de tekencode is rekenwerk)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
